# Postgres connection string.
# On Render: create a "PostgreSQL" instance and paste its "Internal Database URL" here
# (use the "External Database URL" only if the DB isn't on Render).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Render's managed Postgres requires SSL. Leave this as "true" when deploying there.
DB_SSL=true

# Comma-separated list of origins allowed to call this API (your website's URL(s)).
# Example: https://aplustech.com,https://www.aplustech.com
# You can also temporarily use "*" while testing, but lock this down before going live.
FRONTEND_ORIGIN=http://localhost:5500

# Long random string used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on. Render sets this automatically, so you usually don't
# need to set it yourself in the Render dashboard.
PORT=4000

# --- Used only by scripts/create-admin.js to create/update an admin login ---
ADMIN_EMAIL=admin@aplustech.com
ADMIN_PASSWORD=change-this-password
